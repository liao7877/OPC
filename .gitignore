# WorkBuddy 项目数据（含本地记忆/隐私，不入库）
.workbuddy/
.workbuddy/**

# 依赖
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# 日志与临时
*.log
*.tmp
.DS_Store
Thumbs.db

# OPC 命名空间稳定锚（companies/<cid> 是 OS 级 junction/symlink，由 scripts/link-company 重建，不入库）
# 注意：Windows 上 git 默认 core.symlinks=false，提交 symlink 会退化成文本文件、clone 后失效，故必须忽略。
companies/

# 看板数据产物（投影：真相在 *.md / tasks/，clone 后跑 run_boards once 重建）
# generated_at 每次生成必变，入库 = 永久噪音 diff + 合并冲突，故不追踪
*-data.js
tasks-data.json
*.tmp

# 并发锁文件（file_lock 运行时产物；锁释放后即删，残留不该入库）
*.lock

# 环境变量/凭据（防御性，正常不存在）
.env
.env.*
*.pem
*.key

**/skills/INDEX.md

# 知识库索引（决策 #19 生成物：opc_model --sync-index 产出，勿手改；服务监听目录变动自动重生成，
# 入库 = 永久噪音 diff。注：KB-CHANGELOG.md 是变更留痕（只增不删），**入库**保留审计价值）
**/knowledge/INDEX.md

# 巡检运行时态（派生/可变：state 可重建，pending 是快照；patrol-log 是审计流水，保留入库）
patrol-state.json
patrol-pending.md

# OPC 发布用临时构建目录（opc-publish 生成：剥离私有后的干净克隆，不入库）
.opc-publish-build/

# Immutable projection releases and current pointer (rebuildable local artifacts)
.opc-data/
*/.opc-kb-promote.journal.json
.opc-sync/

# 第三方项目克隆（自带 .git 的嵌套仓库，体积 268MB/2849 文件，入库会炸仓库；本地保留、不入库）
# 判据：凡是 clone 下来的外部仓库都按此处理——需要引用就写调研结论，不要整包收进 OPC。
**/OpenMAIC/

# 商业私密项目（含域名资产、支付渠道调研、资质核查；属个人商业信息，不入库、不发布）
C001-AI自动化公司/P0005-算命网站变现项目/

# AI process material is local; portable synthetic regressions are versioned.
_AI工作区/*
!_AI工作区/回归测试/

# Machine-local platform settings contain absolute paths and are regenerated.
.zcode/
.claude/settings.local.json

# Private user-facing review reports remain local.
OPC项目体检报告-*.md
OPC问题修复交付-*.md
OPC复查与同步-*.md
