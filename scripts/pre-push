#!/bin/sh
# OPC public-push guard: $1 is the remote name; stdin contains refs.
root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 1
PY=$OPC_PYTHON
if [ -z "$PY" ]; then PY=$(command -v python3 || command -v python || command -v py) || exit 1; fi
PY=$("$PY" "$root/opc_runtime.py") || exit 1
exec "$PY" "$root/opc_privacy.py" --guard "$1" "$2"
