#!/bin/sh
# OPC reference gate; interpreter selection is centralized in opc_runtime.
root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 1
PY=$OPC_PYTHON
if [ -z "$PY" ]; then PY=$(command -v python3 || command -v python || command -v py) || exit 1; fi
exec "$PY" "$root/opc_resolver.py" --check
